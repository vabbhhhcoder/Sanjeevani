# Copy to .env — Vite injects VITE_* vars at build time
VITE_AI_PROVIDER=gemini            # gemini | openai (openai = any OpenAI-compatible endpoint incl. Groq/Ollama)
VITE_AI_API_KEY=AIza-your-key-here
VITE_AI_MODEL=gemini-3.6-flash
VITE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
